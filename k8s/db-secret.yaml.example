# Copy this to db-secret.yaml, fill in real values, and DO NOT commit the real
# file to git (add k8s/db-secret.yaml to .gitignore). Apply with:
#   kubectl apply -f k8s/db-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: db-credentials
  namespace: microservices-demo
type: Opaque
stringData:
  DB_USER: postgres
  DB_PASSWORD: "CHANGE_ME"
  # Cloud SQL instance connection name, format: PROJECT_ID:REGION:INSTANCE_NAME
  INSTANCE_CONNECTION_NAME: "PROJECT_ID:REGION:microservices-db"
